# Copy to .env and fill in. Both values come from your Spotify app at
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must match a redirect URI registered in the Spotify app character for
# character. Spotify accepts only HTTPS URLs or an explicit loopback address, so
# "localhost" and a LAN URL such as http://192.168.1.100:8888/callback are both
# rejected outright. Leave this as-is: on Windows you browse it directly, and on
# the Linux box you reach it through an SSH tunnel. See README, "Connect".
REDIRECT_URI=http://127.0.0.1:8888/callback

PORT=8888

# Where the refresh token is written. Defaults to ./data locally; the container
# overrides it to /data, which is the named volume.
# DATA_DIR=./data

# Optional: skip the browser flow entirely by pasting a refresh token you
# already have. Saved to the data volume on first start.
# SPOTIFY_REFRESH_TOKEN=

# Optional polling cadence in milliseconds. 3s while playing is ~20 requests a
# minute, comfortably inside Spotify's limits. Polling stops completely when no
# overlay or setup page is connected.
# POLL_PLAYING_MS=3000
# POLL_IDLE_MS=10000
